using UnityEngine;
using UnityEngine.UI;
using System.Collections.Generic;

// ============================================================================
// FILE 1: THE BRAIN & BITLIFE DATA ENGINE
// ============================================================================
public class BitLifeCustomizer : MonoBehaviour
{
    [Header("--- CHARACTER PROFILE ---")]
    public string characterName = "Jay";
    public int cashBalance = 4200;
    public List<string> playerInventory = new List<string>();

    [Header("--- UI WINDOWS ---")]
    public GameObject customizerPanel;
    public Text customizerText;
    public Text mainGameplayHUD;

    [Header("--- SCRIPTS ---")]
    public PlayerGTAController movementScript;

    private string[] outfits = { "Casual Hoodie", "Streetwear Tracksuit", "Retro Tie-Dye", "Biker Jacket" };
    private int outfitIndex = 0;
    private bool isCustomizing = true;
    private string chosenOutfit = "Casual Hoodie";

    private void Start()
    {
        if (movementScript != null) movementScript.enabled = false; 
        if (customizerPanel != null) customizerPanel.SetActive(true);
        RenderCustomizer();
    }

    private void Update()
    {
        if (!isCustomizing) return;

        if (Input.GetKeyDown(KeyCode.DownArrow) || Input.GetKeyDown(KeyCode.S))
        {
            outfitIndex = (outfitIndex + 1) % outfits.Length;
            RenderCustomizer();
        }
        if (Input.GetKeyDown(KeyCode.UpArrow) || Input.GetKeyDown(KeyCode.W))
        {
            outfitIndex = (outfitIndex - 1 + outfits.Length) % outfits.Length;
            RenderCustomizer();
        }

        if (Input.GetKeyDown(KeyCode.Space) || Input.GetKeyDown(KeyCode.JoystickButton0))
        {
            chosenOutfit = outfits[outfitIndex];
            isCustomizing = false;
            if (customizerPanel != null) customizerPanel.SetActive(false);
            if (movementScript != null) movementScript.enabled = true; 
            UpdateHUD();
        }
    }

    private void RenderCustomizer()
    {
        if (customizerText == null) return;
        customizerText.text = "<b>=== CHARACTER CUSTOMIZER ===</b>\nNAME: " + characterName + "\nSTARTING FUNDS: $" + cashBalance + "\n\nCHOOSE OUTFIT STYLE:\n";
        for (int i = 0; i < outfits.Length; i++)
        {
            if (i == outfitIndex) customizerText.text += " > [" + outfits[i] + "] <\n";
            else customizerText.text += "   " + outfits[i] + "\n";
        }
        customizerText.text += "\n<i>Press [A] to Spawn Into World</i>";
    }

    public void UpdateHUD()
    {
        if (mainGameplayHUD == null) return;
        string inventoryString = playerInventory.Count > 0 ? string.Join(", ", playerInventory.ToArray()) : "Empty";
        mainGameplayHUD.text = "<b>NAME:</b> " + characterName + "  |  <b>OUTFIT:</b> " + chosenOutfit + "  |  <b>WALLET:</b> $" + cashBalance + "\n<b>ITEMS:</b> " + inventoryString;
    }
}

// ============================================================================
// FILE 2: THE GTA PHYSICS & MOVEMENT ENGINE
// ============================================================================
public class PlayerGTAController : MonoBehaviour
{
    [Header("--- GTA PHYSICS & MOVEMENT ---")]
    public CharacterController controller;
    public Transform mainCamera;
    public float walkSpeed = 5.0f;
    public float sprintSpeed = 9.0f;
    public float jumpHeight = 2.0f;
    public float gravityForce = -25.0f; 

    [Header("--- INTERACTIVE ITEM HANDLING ---")]
    public ParticleSystem bluntSmokeSystem;
    public ParticleSystem bongSmokeSystem;
    public BitLifeCustomizer inventoryData;

    private Vector3 velocity;
    private bool isGrounded;
    [HideInInspector] public bool isDriving = false;

    private void Awake()
    {
        QualitySettings.vSyncCount = 1;
        Application.targetFrameRate = 60;
    }

    private void Update()
    {
        if (isDriving) return;
        isGrounded = controller.isGrounded;
        if (isGrounded && velocity.y < 0) velocity.y = -2f; 

        ProcessGTAMovementInput();
        ProcessActionMechanicsInput();
    }

    private void ProcessGTAMovementInput()
    {
        float horiz = Input.GetAxis("Horizontal");
        float vert = Input.GetAxis("Vertical");
        Vector3 direction = new Vector3(horiz, 0f, vert).normalized;

        if (direction.magnitude >= 0.1f)
        {
            bool isSprinting = Input.GetKey(KeyCode.JoystickButton8) || Input.GetKey(KeyCode.LeftShift);
            float currentMoveSpeed = isSprinting ? sprintSpeed : walkSpeed;
            float targetAngle = Mathf.Atan2(direction.x, direction.z) * Mathf.Rad2Deg + mainCamera.eulerAngles.y;
            Vector3 moveDir = Quaternion.Euler(0f, targetAngle, 0f) * Vector3.forward;

            controller.Move(moveDir.normalized * currentMoveSpeed * Time.deltaTime);
            transform.rotation = Quaternion.Slerp(transform.rotation, Quaternion.Euler(0f, targetAngle, 0f), 0.25f);
        }

        if ((Input.GetButtonDown("Jump") || Input.GetKeyDown(KeyCode.JoystickButton0)) && isGrounded)
        {
            velocity.y = Mathf.Sqrt(jumpHeight * -2.0f * gravityForce);
        }

        velocity.y += gravityForce * Time.deltaTime;
        controller.Move(velocity * Time.deltaTime);
    }

    private void ProcessActionMechanicsInput()
    {
        if (inventoryData == null) return;
        if (Input.GetKeyDown(KeyCode.JoystickButton5) || Input.GetKeyDown(KeyCode.E))
        {
            if (inventoryData.playerInventory.Contains("Premium Exotic Bud") || inventoryData.playerInventory.Contains("Infused Fudge Brownie"))
            {
                if (inventoryData.playerInventory.Contains("Glass Vortex Rig") && bongSmokeSystem != null) bongSmokeSystem.Play();
                else if (bluntSmokeSystem != null) bluntSmokeSystem.Play();
            }
        }
    }
}

// ============================================================================
// FILE 3: THE 2026 VEHICLE FLEET (CYBERTRUCK & SCAT PACK)
// ============================================================================
public class RealisticVehicleEngine : MonoBehaviour
{
    public enum VehicleType { TeslaCybertruck, DodgeScatPack }
    [Header("--- AUTOMOTIVE SELECTION ---")]
    public VehicleType specificModel = VehicleType.DodgeScatPack;

    [Header("--- CORE PHYSICS CONTROLLER ---")]
    public Rigidbody vehicleRigidbody;
    public PlayerGTAController playerScript;
    public Transform mainCamera;

    private float engineHorsepower;
    private float driftHandlingTraction;
    private float electronicTopSpeed;

    private void Start()
    {
        if (specificModel == VehicleType.TeslaCybertruck)
        {
            engineHorsepower = 3200f;       
            driftHandlingTraction = 0.85f;  
            electronicTopSpeed = 130f;
        }
        else if (specificModel == VehicleType.DodgeScatPack)
        {
            engineHorsepower = 2200f;       
            driftHandlingTraction = 0.40f;  
            electronicTopSpeed = 175f;
        }
    }

    private void FixedUpdate()
    {
        if (playerScript == null || !playerScript.isDriving) return;

        float steeringInput = Input.GetAxis("Horizontal");
        float acceleratorTrigger = Input.GetAxis("Xbox_RightTrigger");
        float brakeTrigger = Input.GetAxis("Xbox_LeftTrigger");

        if (acceleratorTrigger == 0 && brakeTrigger == 0)
        {
            acceleratorTrigger = Input.GetKey(KeyCode.W) ? 1.0f : 0.0f;
            brakeTrigger = Input.GetKey(KeyCode.S) ? 1.0f : 0.0f;
        }

        if (vehicleRigidbody.velocity.magnitude < electronicTopSpeed)
        {
            if (acceleratorTrigger > 0.05f) vehicleRigidbody.AddForce(transform.forward * acceleratorTrigger * engineHorsepower * Time.fixedDeltaTime, ForceMode.VelocityChange);
            if (brakeTrigger > 0.05f) vehicleRigidbody.AddForce(-transform.forward * brakeTrigger * engineHorsepower * Time.fixedDeltaTime, ForceMode.VelocityChange);
        }

        if (vehicleRigidbody.velocity.magnitude > 1.0f)
        {
            float dynamicTractionModifier = Vector3.Dot(transform.forward, vehicleRigidbody.velocity) >= 0 ? 1.0f : -1.0f;
            transform.Rotate(Vector3.up, steeringInput * (driftHandlingTraction * 50f) * dynamicTractionModifier * Time.fixedDeltaTime);
        }
    }

    private void LateUpdate()
    {
        if (playerScript == null || !playerScript.isDriving || mainCamera == null) return;
        mainCamera.position = Vector3.Lerp(mainCamera.position, transform.position + (transform.rotation * new Vector3(0, 4.5f, -8.5f)), 0.2f);
        mainCamera.LookAt(transform.position + Vector3.up);
    }
}

// ============================================================================
// FILE 4: THE STONER HIDEOUT STOREFRONT & SECURITY
// ============================================================================
public class DispensaryEngine : MonoBehaviour
{
    [System.Serializable]
    public class ShopProduct { public string name; public int price; }

    [Header("--- STONER HIDEOUT STAFFING ---")]
    public string primaryClerk = "Snoop Dogg";
    public string assistantClerk = "FlightReacts";
    public string securityStaff = "Tactical Security Guard";

    [Header("--- SYSTEM INTERFACES ---")]
    public Transform shopDoorwayMarker;
    public GameObject dashboardUIPanel;
    public Text interfaceTextMesh;
    public PlayerGTAController playerController;
    public BitLifeCustomizer customizerDatabase;

    public List<ShopProduct> dispensaryMenu = new List<ShopProduct>();
    private int selectedProductIndex = 0;
    private bool isPlayerInsideStore = false;

    private void Start()
    {
        dispensaryMenu.Add(new ShopProduct { name = "Premium Exotic Bud", price = 150 });
        dispensaryMenu.Add(new ShopProduct { name = "Glass Vortex Rig", price = 600 });
dispensaryMenu.Add(new ShopProduct { name = "Concentrate Vaporizer Pen", price = 350 });
dispensaryMenu.Add(new ShopProduct { name = "Infused Fudge Brownie", price = 50 });
if (dashboardUIPanel != null) dashboardUIPanel.SetActive(false);
}
private void Update()
{
if (playerController == null || shopDoorwayMarker == null) return;
float spatialGap = Vector3.Distance(playerController.transform.position, shopDoorwayMarker.position);
if (!isPlayerInsideStore && spatialGap <= 3.5f && !playerController.isDriving) TriggerShopMenuOpen();
if (isPlayerInsideStore) ProcessStoreMenuInputs();
}
private void TriggerShopMenuOpen()
{
isPlayerInsideStore = true;
if (dashboardUIPanel != null) dashboardUIPanel.SetActive(true);
playerController.enabled = false;
RenderDispensaryLayoutScreen();
}
private void ProcessStoreMenuInputs()
{
if (Input.GetKeyDown(KeyCode.DownArrow) || Input.GetKeyDown(KeyCode.S)) { selectedProductIndex = (selectedProductIndex + 1) % dispensaryMenu.Count; RenderDispensaryLayoutScreen(); }
if (Input.GetKeyDown(KeyCode.UpArrow) || Input.GetKeyDown(KeyCode.W)) { selectedProductIndex = (selectedProductIndex - 1 + dispensaryMenu.Count) % dispensaryMenu.Count; RenderDispensaryLayoutScreen(); }
if (Input.GetKeyDown(KeyCode.Space) || Input.GetKeyDown(KeyCode.JoystickButton0))
{
ShopProduct activeSelection = dispensaryMenu[selectedProductIndex];
if (customizerDatabase != null && customizerDatabase.cashBalance >= activeSelection.price)
{
customizerDatabase.cashBalance -= activeSelection.price;
customizerDatabase.playerInventory.Add(activeSelection.name);
RenderDispensaryLayoutScreen();
customizerDatabase.UpdateHUD();
}
}
if (Input.GetKeyDown(KeyCode.Escape) || Input.GetKeyDown(KeyCode.JoystickButton1))
{
isPlayerInsideStore = false;
if (dashboardUIPanel != null) dashboardUIPanel.SetActive(false);
playerController.enabled = true;
playerController.transform.position += new Vector3(0f, 0f, -3.0f);
}
}
private void RenderDispensaryLayoutScreen()
{
if (interfaceTextMesh == null || customizerDatabase == null) return;
string clerkDialogue = (selectedProductIndex == 0)
? "[" + primaryClerk + "]: 'Drop it like it's hot, nephew. That's top shelf organic right there.'"
: "[" + assistantClerk + "]: 'Look at the detail! No way man, look at the scaling! Is that real?! LETS GOOO!'";
interfaceTextMesh.text = "=== STONER HIDEOUT SHOP MAIN OFFICE ===\n[SECURITY STATUS]: " + securityStaff + " standing guard at main entrance.\n\n" + clerkDialogue + "\n\nYOUR CURRENT WALLET: $" + customizerDatabase.cashBalance + "\n--------------------------------------------------\n";
for (int i = 0; i < dispensaryMenu.Count; i++)
{
if (i == selectedProductIndex) interfaceTextMesh.text += "  ==> [" + dispensaryMenu[i].name + " - $" + dispensaryMenu[i].price + "] <==\n";
else interfaceTextMesh.text += "      " + dispensaryMenu[i].name + " - $" + dispensaryMenu[i].price + "\n";
}
interfaceTextMesh.text += "\n\n[Xbox A] Purchase Selected Good  |  [Xbox B] Walk Out Past Security";
}
}
